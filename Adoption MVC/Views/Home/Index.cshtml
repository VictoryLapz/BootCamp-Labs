@model AnimalType

<h2>Adoption Center</h2>

<table>
    <tr>
        <th>Name</th>
        <th>Breed</th>
        <th>Image</th>
        <th>Action</th>
    </tr>
    @foreach (var animal in Model)
    {
        <tr>
            <td>@animal.Name</td>
            <td>@animal.Breed</td>
            <td><img src="@animal.Img" alt="@animal.Name" width="100" /></td>
            <td>
                <form asp-action="Adopt" method="post">
                    <input type="hidden" name="id" value="@animal.Id" />
                    <button type="submit">Adopt</button>
                </form>
            </td>
        </tr>
    }
</table>